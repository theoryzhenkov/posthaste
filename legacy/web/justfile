# Frontend (React/Vite) recipes

set working-directory := '../..'

# Start the Vite dev server alone. Assumes the backend is already running.
dev:
    bun --cwd=apps/web run dev

# Production build
build:
    bun --cwd=apps/web run build

# Lint, typecheck, and verify formatting
check:
    bun --cwd=apps/web run check

# Typecheck
typecheck:
    bun --cwd=apps/web run typecheck

# Run frontend tests
test:
    bun --cwd=apps/web run test

# Format frontend sources
fmt:
    bun --cwd=apps/web run format

# Check frontend formatting
fmt-check:
    bun --cwd=apps/web run format:check

# Lint with auto-fix, then format
lint-fix:
    bun --cwd=apps/web run lint --fix
    bun --cwd=apps/web run format

# Preview production build
preview:
    bun --cwd=apps/web run preview

# Install dependencies
install:
    bun install
