# Docs recipes. The docs are published by the Astro/Starlight site in
# apps/site (the /docs section); these recipes cover the generated artifacts and
# a local preview via the site.

set working-directory := '..'

# Regenerate the API endpoint inventory from openapi.json (committed artifact)
gen-endpoints:
    python3 tools/docs/gen_endpoints.py

# Serve the docs locally via the site's dev server (Starlight owns /docs)
serve: gen-endpoints
    bun --cwd=apps/site run dev

# Build the site (includes the Starlight docs + Pagefind index)
build: gen-endpoints
    bun --cwd=apps/site run build
