# Backend (Rust workspace) recipes

set working-directory := '..'

# Run the local server
run *args:
    cargo run --bin posthasted -- serve {{args}}

# Build all crates
build:
    bash tools/dev/logs/check-rust-contract.sh
    cargo build

# Build in release mode
build-release:
    bash tools/dev/logs/check-rust-contract.sh
    cargo build --release

# Run tests
test *args:
    cargo test --workspace --exclude posthaste-desktop {{args}}

# Run clippy + check
check:
    bash tools/dev/logs/check-rust-contract.sh
    cargo clippy --workspace --exclude posthaste-desktop --all-targets -- -D warnings

# Format code
fmt:
    cargo fmt --all

# Check formatting
fmt-check:
    cargo fmt --all -- --check
