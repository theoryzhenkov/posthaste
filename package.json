{
  "name": "posthaste",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/web",
    "apps/site",
    "apps/mcp"
  ],
  "scripts": {
    "web:dev": "bun --cwd=apps/web run dev",
    "web:build": "bun --cwd=apps/web run build",
    "web:check": "bun --cwd=apps/web run check",
    "web:test": "bun --cwd=apps/web run test",
    "site:dev": "bun --cwd=apps/site run dev",
    "site:build": "bun --cwd=apps/site run build",
    "site:check": "bun --cwd=apps/site run check",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "lab:tauri-playwright": "playwright test --config tools/lab/tauri-playwright/playwright.config.ts --project=tauri-main"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@srsholmes/tauri-playwright": "0.2.2",
    "@tauri-apps/cli": "2.10.1"
  }
}
