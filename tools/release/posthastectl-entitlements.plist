<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime entitlements for the posthastectl CLI binary.

  Notarization (required by Apple to clear Gatekeeper without a manual
  override) requires the hardened runtime, enabled via codesign's "options
  runtime" flag. The CLI is a Bun "compile" executable, which embeds
  JavaScriptCore and JIT compiles at runtime; the hardened runtime blocks
  JIT and writable plus executable memory and unsigned dynamic code by
  default, which would turn a fixed Gatekeeper rejection into a runtime
  crash on first JIT allocation. These entitlements are the same class
  Bun, Node, and Electron embedders need under the hardened runtime; see
  tools/release/sign-and-package-cli.sh.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
