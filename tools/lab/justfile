# Lab control-plane recipes

set working-directory := '../..'

# List suites from the lab registry.
suite *args:
    cargo run -p posthaste-lab -- suite {{ args }}

# Execute selected suites and write a lab manifest/summary.
verify *args:
    cargo run -p posthaste-lab -- verify {{ args }}

# Execute suites selected from changed paths. Pass normal verify filters after `changed`.
changed *args:
    cargo run -p posthaste-lab -- verify --changed {{ args }}

# Cheap non-graphical lab smoke: registry loading and executable suites.
smoke:
    cargo run -p posthaste-lab -- suite list
    cargo run -p posthaste-lab -- verify --tag lab-smoke --run-root target/lab/smoke

# Typecheck and format-check the optional Tauri Playwright lab files.
tauri-check:
    bun --cwd=legacy/web run tsc -p ../../tools/lab/tauri-playwright/tsconfig.json --noEmit
    bun --cwd=legacy/web run prettier ../../tools/lab/tauri-playwright --check

# Optional graphical Linux Tauri smoke through tauri-playwright.
tauri-smoke *args:
    bash tools/lab/tauri-playwright/smoke.sh {{ args }}

# --- Profiling (offline store hot paths) -------------------------------------

# CPU flamegraphs (pprof SVG + protobuf) and dhat heap profiles for each
# offline store operation. Pass `--out <dir>` to control the artifact location.
profile *args:
    cargo run --release -p posthaste-bench --bin posthaste-profile -- {{ args }}

# Criterion wall-clock benchmarks (HTML + JSON under target/criterion).
bench *args:
    cargo bench -p posthaste-bench --bench store_criterion -- {{ args }}

# Deterministic iai-callgrind regression gate. Requires valgrind and a matching
# iai-callgrind-runner (`cargo install iai-callgrind-runner --version 0.16.1`).
bench-gate *args:
    cargo bench -p posthaste-bench --bench store_iai -- {{ args }}

# Local-only perf flamegraph for deep dives. Requires `perf` and cargo-flamegraph
# (`cargo install flamegraph`) plus a relaxed kernel.perf_event_paranoid.
flamegraph-perf *args:
    cargo flamegraph -p posthaste-bench --bin posthaste-profile -- {{ args }}
