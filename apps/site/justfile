# Public website recipes

set working-directory := '../..'

dev:
    bun --cwd=apps/site run dev

build:
    bun --cwd=apps/site run build

check:
    bun --cwd=apps/site run check

typecheck:
    bun --cwd=apps/site run typecheck

fmt:
    bun --cwd=apps/site run format

fmt-check:
    bun --cwd=apps/site run format:check

lint-fix:
    bun --cwd=apps/site run lint --fix
    bun --cwd=apps/site run format

preview:
    bun --cwd=apps/site run preview

install:
    bun install
