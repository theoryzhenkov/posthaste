---
import '@fontsource-variable/geist/index.css'
import '@fontsource-variable/geist-mono/index.css'
import { getHomeContent } from '../content/homeContent'
import { Wizard } from '../Wizard'
import '../styles.css'

const content = await getHomeContent()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Self-host Posthaste with the wizard — one command bootstraps a backend or runtime node, distributed, TLS-ready, and checksum-verified."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Wizard — Posthaste</title>
  </head>
  <body>
    <Wizard footer={content.footer} client:load />
  </body>
</html>
