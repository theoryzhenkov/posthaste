---
import '@fontsource-variable/geist/index.css'
import '@fontsource-variable/geist-mono/index.css'
import { getDocs } from '../../content/docsContent'
import { getHomeContent } from '../../content/homeContent'
import type { DocEntry } from '../../content/types'
import { FooterSection, InstallHeader } from '../../SiteChrome'
import '../../styles.css'

export async function getStaticPaths() {
  const docs = await getDocs()
  return docs.map((entry) => ({
    params: { slug: entry.slug === 'index' ? undefined : entry.slug },
    props: { entry },
  }))
}

interface Props {
  entry: DocEntry
}

const { entry } = Astro.props
const [docs, content] = await Promise.all([getDocs(), getHomeContent()])

const index = docs.findIndex((doc) => doc.slug === entry.slug)
const prev = index > 0 ? docs[index - 1] : null
const next = index < docs.length - 1 ? docs[index + 1] : null
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={entry.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{entry.title} — Posthaste docs</title>
  </head>
  <body>
    <main class="site-shell docs-shell">
      <InstallHeader active="docs" />

      <div class="docs-layout">
        <details class="docs-sidebar">
          <summary>Documentation</summary>
          <nav class="docs-nav" aria-label="Documentation">
            <span class="docs-nav-title">Guide</span>
            <ul>
              {
                docs.map((doc) => (
                  <li>
                    <a
                      href={doc.href}
                      aria-current={doc.slug === entry.slug ? 'page' : undefined}
                    >
                      {doc.navLabel}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </details>

        <div class="docs-main">
          <article class="doc-prose" set:html={entry.html} />

          <nav class="docs-pager" aria-label="Guide pages">
            {
              prev ? (
                <a class="docs-pager-link is-prev" href={prev.href}>
                  <span class="docs-pager-dir">← Previous</span>
                  <span class="docs-pager-label">{prev.navLabel}</span>
                </a>
              ) : (
                <span />
              )
            }
            {
              next ? (
                <a class="docs-pager-link is-next" href={next.href}>
                  <span class="docs-pager-dir">Next →</span>
                  <span class="docs-pager-label">{next.navLabel}</span>
                </a>
              ) : (
                <span />
              )
            }
          </nav>
        </div>
      </div>

      <FooterSection content={content.footer} />
    </main>
  </body>
</html>
