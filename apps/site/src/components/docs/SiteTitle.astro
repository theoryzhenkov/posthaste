---
// Brand site title for the docs header: the Posthaste logo + wordmark, linking
// back to the marketing landing so the docs feel like part of the site.
---

<a href="/" class="site-title sl-flex" aria-label="Posthaste home">
  <img src="/posthaste-logo.svg" alt="" width="28" height="28" />
  <span class="wordmark" translate="no">Posthaste</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: 0.55rem;
    font-size: var(--sl-text-h4);
    font-weight: 650;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    overflow: clip;
    min-width: 0;
  }
  .site-title img {
    height: 1.75rem;
    width: auto;
  }
  .wordmark {
    letter-spacing: -0.01em;
  }
</style>
