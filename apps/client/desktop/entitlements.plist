<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the desktop app's bundled binaries.

  Tauri's macOS signing pass is "inside-out": it applies ONE entitlements file
  to every binary it bundles — the app itself AND any `bundle.externalBin`
  sidecars. This plist exists because the `posthastectl` sidecar
  (`bundle.externalBin`) is a Bun `--compile` executable that embeds
  JavaScriptCore and JIT-compiles at runtime. Notarization requires the
  hardened runtime, which blocks JIT / writable-executable memory / unsigned
  dynamic code by default — without these entitlements the sidecar crashes on
  its first JIT allocation (a fixed Gatekeeper "damaged" → runtime crash).

  Tradeoff: the desktop app binary (`posthaste-client`, pure Rust, no JIT)
  is also signed with this plist, so it picks up these permissive entitlements
  even though it does not use them. This widens the app's own surface
  slightly (it could load unsigned libraries). We accept this as the cost of
  Tauri's single-entitlements signing model; the alternative — signing the
  sidecar separately outside Tauri — results in Tauri re-signing it
  hardened+no-entitlements and crashing it (verified in the original
  sidecar work, commit 477e6810). Same class of entitlements Bun/Node/Electron
  embedders need under the hardened runtime.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
