# Desktop (Tauri) app recipes. Runs from the repo root.
# apps/client/desktop/ is three levels under the repo root, so `../../..`.

set working-directory := '../../..'

# Thin wrapper over the shared script the release build and the CI packaging
# gate also call, so local staging cannot drift from what ships. Idempotent —
# delete apps/client/desktop/binaries/posthastectl-* to refresh after changing
# the CLI. See tools/release/stage-sidecar.sh for the contract.
#
# Stage the posthastectl Tauri sidecar for a local `tauri build`.
stage-sidecar:
    bash tools/release/stage-sidecar.sh

