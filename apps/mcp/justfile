# MCP server + posthastectl CLI (one operation registry, two front-ends)

set working-directory := '../..'

# Typecheck, test, and verify formatting
check:
    bun --cwd=apps/mcp run check

# Typecheck only
typecheck:
    bun --cwd=apps/mcp run typecheck

# Run the registry + CLI tests
test:
    bun --cwd=apps/mcp run test

# Format sources
fmt:
    bun --cwd=apps/mcp run format

# Check formatting
fmt-check:
    bun --cwd=apps/mcp run format:check

# Run the MCP stdio server
mcp:
    bun --cwd=apps/mcp run start

# Run the posthastectl CLI (pass args after `--`)
cli *args:
    bun --cwd=apps/mcp run cli {{ args }}

# Compile the standalone posthastectl binary to apps/mcp/dist/posthastectl
build-cli:
    bun --cwd=apps/mcp run build:cli

# Cross-compile the standalone posthastectl binary for a bun target.
# Usage: just mcp build-cli-target bun-darwin-arm64 [outfile]
# target: bun-linux-x64 | bun-linux-arm64 | bun-darwin-x64 | bun-darwin-arm64 | bun-windows-x64
# outfile: optional, repo-root-relative or absolute; defaults to
#   apps/mcp/dist/posthastectl-<os>-<arch>. Bun appends .exe for windows targets;
#   the build script prints the final artifact path as its last line of stdout.
build-cli-target target outfile='':
    bun run apps/mcp/scripts/build-cli.ts -- {{ target }} {{ outfile }}

# Regenerate the typed API schema from openapi.json
api-generate:
    bun --cwd=apps/mcp run api:generate
