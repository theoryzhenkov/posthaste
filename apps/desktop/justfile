# Desktop (Tauri) recipes

set working-directory := '../..'

# Stage the posthastectl Tauri sidecar for local builds. `bundle.externalBin`
# in tauri.conf.json requires apps/desktop/binaries/posthastectl-<host-triple>
# to exist BEFORE `tauri dev`/`tauri build` (Tauri validates externalBin at
# bundle time). Idempotent — skips if already staged; delete the file to
# refresh after changing the CLI. CI stages the signed cross-compiled release
# binaries itself (see .github/workflows/release.yml).
stage-sidecar:
    #!/usr/bin/env bash
    set -euo pipefail
    triple="$(rustc -vV | sed -n 's/^host: //p')"
    ext=""
    case "$triple" in *windows*) ext=".exe";; esac
    dest="apps/desktop/binaries/posthastectl-${triple}${ext}"
    if [ -f "$dest" ]; then echo "sidecar already staged: $dest"; exit 0; fi
    mkdir -p apps/desktop/binaries
    out="$(bun run apps/mcp/scripts/build-cli.ts | tail -1)"
    cp "$out" "$dest"
    chmod +x "$dest"
    echo "staged sidecar: $dest"

# Run tauri alone (backend embedded, vite via beforeDevCommand). Does NOT start stalwart.
dev *args:
    bun run tauri dev {{args}}

# Run desktop Rust tests with constrained Cargo parallelism. The Tauri Linux
# dependency graph links GTK/WebKit and can OOM smaller VMs when combined with
# workspace-wide test fan-out.
test *args:
    cargo test -p posthaste-desktop -j 1 {{args}}

# Check the desktop crate with constrained Cargo parallelism for the same
# reason as `test`.
check:
    cargo clippy -p posthaste-desktop -j 1 --all-targets -- -D warnings

# Build for release
build *args:
    bun run tauri build {{args}}

# Regenerate the nightly-channel app icon set from its SVG master. The release
# workflow points `bundle.icon` at `icons-nightly/` for the nightly channel
# (see tools/release/channel-policy.sh). Run this after editing the master.
regen-nightly-icons:
    bun run tauri icon apps/web/public/favicon-night.svg -o apps/desktop/icons-nightly
